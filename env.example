# Discord / database (fill with your real Render Environment values)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DATABASE_URL=

# Existing worker settings
DISCORD_BOT_POLL_INTERVAL=3
DISCORD_BOT_JOB_MAX_ATTEMPTS=5

# DLP website monitor
DLP_WEBSITE_URL=https://dlpweb.onrender.com
DLP_WEBSITE_STATUS_URL=https://dlpweb.onrender.com/api/bot-health
DLP_WEBSITE_CHECK_INTERVAL=60
DLP_WEBSITE_TIMEOUT=10

# Discord role IDs required by the existing bot
DISCORD_ROLE_LONGTOU_ID=
DISCORD_ROLE_ZHANGQI_ID=
DISCORD_ROLE_TANGZHU_ID=
DISCORD_ROLE_ZHANJIANG_ID=
DISCORD_ROLE_MENSHENG_ID=
DISCORD_ROLE_INTERVIEWEE_ID=
DISCORD_ROLE_CITIZEN_ID=

# Initial fallback only. Normal maintenance switching is done with /maintenance in Discord.
DLP_MAINTENANCE_MODE=false
